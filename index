// ============ DATA TABLE ============
function renderTable(filter = '') {
    const tbody = document.getElementById('dataTableBody');
    const noData = document.getElementById('noData');
    const filtered = filter ? apdData.filter(d => 
        d.nama.toLowerCase().includes(filter.toLowerCase()) || 
        d.jenisAPD.toLowerCase().includes(filter.toLowerCase()) ||
        d.dept.toLowerCase().includes(filter.toLowerCase()) ||
        d.nik.includes(filter)
    ) : apdData;
    
    if (filtered.length === 0) {
        tbody.innerHTML = '';
        noData.style.display = 'block';
        return;
    }
    noData.style.display = 'none';
    
    const now = new Date();
    const in30Days = new Date(now.getTime() + 30 * 24 * 60 * 60 * 1000);
    
    tbody.innerHTML = filtered.slice(0, 50).map((d, i) => {
        const expDate = d.tglExp ? new Date(d.tglExp) : null;
        let statusBadge = '<span class="badge badge-green">Aktif</span>';
        if (expDate) {
            if (expDate < now) statusBadge = '<span class="badge badge-red">Kadaluarsa</span>';
            else if (expDate < in30Days) statusBadge = '<span class="badge badge-yellow">Segera Ganti</span>';
        }
        return `<tr>
            <td>${i + 1}</td>
            <td><span style="font-size:11px;color:#3b82f6">${d.noDoc}</span></td>
            <td>${d.tanggal}</td>
            <td><strong>${d.nama}</strong></td>
            <td>${d.nik}</td>
            <td>${d.dept}</td>
            <td>${d.jenisAPD}</td>
            <td>${d.ukuran || '-'}</td>
            <td style="text-align:center">${d.jumlah}</td>
            <td>${d.kondisi}</td>
            <td>${d.tglExp || '-'}</td>
            <td>${statusBadge}</td>
            <td>
                <button class="btn btn-primary" style="font-size:11px;padding:4px 8px" onclick="printById(${d.id})">🖨️</button>
                <button class="btn btn-danger" style="font-size:11px;padding:4px 8px" onclick="deleteRecord(${d.id})">🗑️</button>
            </td>
        </tr>`;
    }).join('');
    
    // Stats
    document.getElementById('statTotal').textContent = apdData.length;
    const thisMonth = new Date().toISOString().slice(0, 7);
    document.getElementById('statBulanIni').textContent = apdData.filter(d => d.tanggal && d.tanggal.startsWith(thisMonth)).length;
    document.getElementById('statExpiring').textContent = apdData.filter(d => {
        if (!d.tglExp) return false;
        const exp = new Date(d.tglExp);
        return exp >= now && exp < in30Days;
    }).length;
}

function filterTable() {
    renderTable(document.getElementById('searchInput').value);
}

function deleteRecord(id) {
    if (!confirm('Hapus record ini?')) return;
    apdData = apdData.filter(d => d.id !== id);
    localStorage.setItem('apdData', JSON.stringify(apdData));
    renderTable(document.getElementById('searchInput').value);
}

function printById(id) {
    const record = apdData.find(d => d.id === id);
    if (record) printTandaTerima(record);
}

function exportCSV() {
    const headers = ['No.Dok', 'Tanggal', 'Nama', 'NIK', 'Departemen', 'Jabatan', 'Jenis APD', 'Ukuran', 'Jumlah', 'Kondisi', 'Tgl Ganti', 'Alasan', 'Catatan'];
    const rows = apdData.map(d => [d.noDoc, d.tanggal, d.nama, d.nik, d.dept, d.jabatan, d.jenisAPD, d.ukuran, d.jumlah, d.kondisi, d.tglExp, d.alasan, d.catatan].map(v => `"${v || ''}"`).join(','));
    const csv = [headers.join(','), ...rows].join('\n');
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = 'APD_Data_' + new Date().toISOString().split('T')[0] + '.csv';
    a.click();
}
