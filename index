<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>APD Monitor - Dashboard & Form Tanda Terima</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.0.0"></script>
    <style>
        /* Dark theme styles */
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { margin: 0; padding: 16px; box-sizing: border-box; width: 100%; font-family: sans-serif; background: #0f1117; color: #e2e8f0; min-height: 100vh; }
        
        /* Cards */
        .card { background: #131927; border-radius: 12px; padding: 16px; color: #e2e8f0; }
        
        /* KPI Cards */
        .kpi-row { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 16px; }
        .kpi-card { flex: 1; min-width: 160px; background: #131927; border-radius: 12px; padding: 16px; }
        
        /* Chart Grid */
        .chart-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-bottom: 16px; }
        canvas { max-width: 100%; }
        
        /* Navigation */
        .nav { display: flex; gap: 8px; margin-bottom: 20px; flex-wrap: wrap; }
        .nav-btn { padding: 8px 16px; border-radius: 8px; border: none; cursor: pointer; font-size: 14px; font-weight: 600; transition: all 0.2s; }
        .nav-btn.active { background: #3b82f6; color: white; }
        .nav-btn:not(.active) { background: #1e2a3a; color: #94a3b8; }
        
        /* Table */
        table { width: 100%; border-collapse: collapse; font-size: 13px; }
        th { background: #1e2a3a; padding: 10px 12px; text-align: left; color: #94a3b8; font-weight: 600; }
        td { padding: 10px 12px; border-bottom: 1px solid #1e2a3a; }
        tr:hover td { background: #1a2535; }
        
        /* Form */
        .form-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
        .form-group { display: flex; flex-direction: column; gap: 6px; }
        .form-group label { font-size: 13px; color: #94a3b8; font-weight: 600; }
        .form-group input, .form-group select, .form-group textarea { background: #1e2a3a; border: 1px solid #2d3748; border-radius: 8px; padding: 10px 12px; color: #e2e8f0; font-size: 14px; outline: none; }
        .form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color: #3b82f6; }
        .btn { padding: 10px 20px; border-radius: 8px; border: none; cursor: pointer; font-size: 14px; font-weight: 600; transition: all 0.2s; }
        .btn-primary { background: #3b82f6; color: white; }
        .btn-primary:hover { background: #2563eb; }
        .btn-success { background: #10b981; color: white; }
        .btn-danger { background: #ef4444; color: white; }
        .btn-secondary { background: #1e2a3a; color: #e2e8f0; }
        
        /* Status badges */
        .badge { padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; }
        .badge-green { background: #064e3b; color: #34d399; }
        .badge-yellow { background: #451a03; color: #fbbf24; }
        .badge-red { background: #450a0a; color: #f87171; }
        .badge-blue { background: #1e3a5f; color: #60a5fa; }
        .badge-chart { background: #1e2a3a; color: #94a3b8; font-size: 11px; padding: 3px 8px; border-radius: 6px; }
        
        /* Header */
        .header { position: relative; border-radius: 16px; overflow: hidden; margin-bottom: 20px; height: 160px; }
        .header-bg { position: absolute; inset: 0; background-image: url('https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=1200&q=80'); background-size: cover; background-position: center; }
        .header-overlay { position: absolute; inset: 0; background: linear-gradient(135deg, rgba(15,17,23,0.92) 0%, rgba(30,42,58,0.85) 100%); }
        .header-content { position: relative; z-index: 1; padding: 24px; height: 100%; display: flex; flex-direction: column; justify-content: center; }
        
        /* Print styles */
        @media print {
            body { background: white; color: black; padding: 0; }
            .no-print { display: none; }
            .print-area { background: white; color: black; padding: 20px; }
            .print-area * { color: black !important; background: white !important; }
        }
        
        /* Responsive */
        @media (max-width: 768px) {
            .chart-grid { grid-template-columns: 1fr; }
            .form-grid { grid-template-columns: 1fr; }
            .kpi-card { min-width: 140px; }
        }
        
        /* Tab content */
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        
        /* Alert */
        .alert { padding: 12px 16px; border-radius: 8px; margin-bottom: 12px; font-size: 14px; }
        .alert-success { background: #064e3b; color: #34d399; }
        .alert-info { background: #1e3a5f; color: #60a5fa; }
        .alert-warning { background: #451a03; color: #fbbf24; }
        
        /* Deploy info */
        .deploy-card { background: #131927; border-radius: 12px; padding: 20px; margin-bottom: 12px; }
        .deploy-step { display: flex; gap: 12px; align-items: flex-start; margin-bottom: 16px; }
        .deploy-num { width: 28px; height: 28px; border-radius: 50%; background: #3b82f6; color: white; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; flex-shrink: 0; }
        code { background: #1e2a3a; padding: 2px 8px; border-radius: 4px; font-family: monospace; font-size: 13px; color: #34d399; }
        pre { background: #1e2a3a; padding: 12px; border-radius: 8px; font-family: monospace; font-size: 12px; color: #34d399; overflow-x: auto; line-height: 1.6; }
        
        /* Signature area */
        .signature-box { border: 2px dashed #2d3748; border-radius: 8px; height: 80px; display: flex; align-items: center; justify-content: center; color: #4b5563; font-size: 13px; }
        
        /* Progress bar */
        .progress-bar { background: #1e2a3a; border-radius: 20px; height: 8px; overflow: hidden; margin-top: 8px; }
        .progress-fill { height: 100%; border-radius: 20px; transition: width 0.5s; }
        
        /* Tanda Terima print */
        .tanda-terima { background: white; color: #111; padding: 32px; border-radius: 12px; }
        .tt-header { text-align: center; border-bottom: 3px double #111; padding-bottom: 16px; margin-bottom: 20px; }
        .tt-title { font-size: 20px; font-weight: 800; color: #111; }
        .tt-subtitle { font-size: 14px; color: #444; }
        .tt-table { width: 100%; border-collapse: collapse; margin: 16px 0; }
        .tt-table th, .tt-table td { border: 1px solid #ccc; padding: 8px 12px; font-size: 13px; }
        .tt-table th { background: #f3f4f6; font-weight: 700; }
        .tt-sign { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 24px; }
        .tt-sign-box { text-align: center; }
        .tt-sign-line { border-top: 1px solid #111; margin-top: 60px; padding-top: 6px; font-size: 12px; }
        
        /* Scrollable table */
        .table-wrapper { overflow-x: auto; }
        
        /* Icon placeholder */
        .icon { font-size: 24px; margin-bottom: 8px; }
        
        /* Chip */
        .chip { display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; border-radius: 20px; font-size: 12px; background: #1e2a3a; color: #94a3b8; }
        
        /* Regulation info */
        .reg-item { display: flex; gap: 12px; padding: 12px; background: #1e2a3a; border-radius: 8px; margin-bottom: 8px; align-items: flex-start; }
        .reg-icon { font-size: 20px; flex-shrink: 0; }
    </style>
</head>
<body>

